# ─────────────────────────────────────────────────────────────────────────────
# AI Camera System — Backend Environment Variables
# Copy this file to .env and edit values as needed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Camera ────────────────────────────────────────────────────────────────────
# Webcam index (0 = default) or RTSP/HTTP stream URL
# Examples:
#   CAMERA_SOURCE=0
#   CAMERA_SOURCE=rtsp://user:pass@192.168.1.10:554/stream
CAMERA_SOURCE=0

# Capture resolution (lower = faster)
FRAME_WIDTH=1280
FRAME_HEIGHT=720

# ── YOLO Object Detector ──────────────────────────────────────────────────────
# Model options: yolov8n.pt (fastest) | yolov8s.pt | yolov8m.pt | yolov8l.pt
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.45
YOLO_IOU=0.45
# Device: cpu | cuda | mps (Apple Silicon)
YOLO_DEVICE=cpu

# ── Qwen3.5-0.8B Vision-Language Model ───────────────────────────────────────
QWEN_MODEL_ID=Qwen/Qwen3.5-0.8B
QWEN_MAX_NEW_TOKENS=150
# How often (seconds) to submit a frame to Qwen for reasoning
QWEN_REASON_INTERVAL=3.0
# Device: cpu | cuda | mps
QWEN_DEVICE=cpu

# ── InsightFace ───────────────────────────────────────────────────────────────
# Model pack: buffalo_l (best) | buffalo_sc (lightweight)
INSIGHTFACE_MODEL=buffalo_l
# Face detection input size — lower = faster
INSIGHTFACE_DET_W=320
INSIGHTFACE_DET_H=320

# ── Inference Worker ──────────────────────────────────────────────────────────
# Max frames per second for the fast capture/YOLO/InsightFace loop
WORKER_MAX_FPS=15.0

# ── MJPEG Stream ──────────────────────────────────────────────────────────────
# JPEG encode quality for the live stream (1 = smallest, 95 = best quality)
STREAM_JPEG_QUALITY=80

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
