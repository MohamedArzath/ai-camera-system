# ─────────────────────────────────────────────────────────────────────────────
# AI Camera Dashboard — Frontend Environment Variables
# Copy this file to .env and edit values as needed.
# ─────────────────────────────────────────────────────────────────────────────

# Backend HTTP base URL (used for REST API calls and health checks)
VITE_API_URL=http://localhost:8001

# WebSocket URL
# Leave BLANK (or remove) in development — the hook auto-derives the URL
# using window.location.host, which routes through the Vite dev proxy.
#
# Set explicitly for production / VPS deployment:
#   VITE_WS_URL=ws://your-vps-domain.com/api/ws
#   VITE_WS_URL=wss://your-vps-domain.com/api/ws   ← use wss:// with HTTPS
VITE_WS_URL=

# MJPEG live stream URL
# In development the Vite proxy handles this too; change for production:
#   VITE_STREAM_URL=http://your-vps-domain.com/api/stream
VITE_STREAM_URL=http://localhost:8001/api/stream

# Milliseconds to wait before attempting a WebSocket reconnect after disconnect
VITE_WS_RECONNECT_DELAY=3000
